        <div class="acc-body">Un protocole de 60 jours minimum est recommandé pour une intégration complète. C'est un complément alimentaire de fond — la régularité de la prise est la clé.</div>
      </div>
      <div class="acc-item">
        <button class="acc-toggle">Compatible avec un traitement ?<span class="plus"></span></button>
        <div class="acc-body">En cas de traitement médicamenteux, grossesse ou allaitement, nous recommandons d'en parler avec votre professionnel de santé avant de commencer.</div>
      </div>
      <div class="acc-item">
        <button class="acc-toggle">Comment fonctionne la garantie 60 jours ?<span class="plus"></span></button>
        <div class="acc-body">Si après 60 jours de prise régulière le protocole ne vous convient pas, vous êtes intégralement remboursé. Même sachet entamé. Une seule demande par email suffit.</div>
      </div>
      <div class="acc-item">
        <button class="acc-toggle">Vegan et sans allergène ?<span class="plus"></span></button>
        <div class="acc-body">Oui — vegan, sans sucre, sans gluten, sans soja, sans lactose, sans OGM. Fabriqué en Allemagne sous normes GMP et ISO 22000.</div>
      </div>
    </div>

    <a href="#" class="explore">
      Toutes les FAQ
      <span>→</span>
    </a>
  </section>

</div>

<script>
  // Hero carousel
  (function() {
    const imgs = document.querySelectorAll('.hero-slide-img');
    const dots = document.querySelectorAll('#hero-dots .hero-dot');
    if (imgs.length <= 1) {
      document.getElementById('hero-arrows').style.display = 'none';
      return;
    }
    let idx = 0;
    function heroGoto(i) {
      imgs[idx].style.opacity = '0'; imgs[idx].classList.remove('active');
      dots[idx] && dots[idx].classList.remove('active');
      idx = (i + imgs.length) % imgs.length;
      imgs[idx].style.opacity = '1'; imgs[idx].classList.add('active');
      dots[idx] && dots[idx].classList.add('active');
    }
    document.getElementById('hero-prev').addEventListener('click', () => heroGoto(idx - 1));
    document.getElementById('hero-next').addEventListener('click', () => heroGoto(idx + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => heroGoto(i)));
  })();

  // Accordions
  document.querySelectorAll('.acc-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.acc-item');
      item.classList.toggle('open');
    });
  });

  // ---------- DYNAMIC PRICING ----------
  // Strike-through prices = full retail per duration (same for both options)
  const STRIKE = { '30': '59 €', '60': '118 €', '90': '178 €' };

  function refreshBuybox() {
    const dur = document.querySelector('.duration-card.selected');
    if (!dur) return;
    const days = dur.dataset.days;

    // Update each sub-option's price/strike/per-day
    document.querySelectorAll('.sub-option').forEach(opt => {
      const type = opt.dataset.type; // 'sub' | 'once'
      const price = dur.dataset[type]; // €
      const perday = dur.dataset['day' + (type === 'sub' ? 'Sub' : 'Once')];
      opt.querySelector('.js-struck').textContent = STRIKE[days];
      opt.querySelector('.js-price').textContent = price + ' €';
      opt.querySelector('.js-perday').textContent = '· ' + perday + ' € /jour';
    });

    // Update CTA — uses currently selected sub-type
    const selOpt = document.querySelector('.sub-option.selected');
    const type = selOpt ? selOpt.dataset.type : 'sub';
    const ctaPrice = dur.dataset[type];
    const verb = type === 'sub' ? 'Commencer' : 'Commander';
    document.querySelector('.js-cta-label').textContent =
      verb + ' mon protocole ' + days + 'j — ' + ctaPrice + ' €';
  }

  // Duration card selection
  document.querySelectorAll('.duration-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.duration-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      refreshBuybox();
    });
  });

  // Sub option selection
  document.querySelectorAll('.sub-option').forEach(opt => {
    opt.addEventListener('click', (e) => {
      e.preventDefault();
      document.querySelectorAll('.sub-option').forEach(o => o.classList.remove('selected'));
      opt.classList.add('selected');
      refreshBuybox();
    });
  });

  // Initial render
  refreshBuybox();

  // ---------- SHOPIFY CART (variant + selling plan binding) ----------
  const VARIANTS = {
    30: 53949330555213,
    60: 53945166233933,
    90: 53945166266701
  };
  const SELLING_PLANS = {
    monthly:   692340752717,
    bimonthly: 692340883789,
    quarterly: 692340916557
  };
  const QTY_TO_PLAN = {
    30: SELLING_PLANS.monthly,
    60: SELLING_PLANS.bimonthly,
    90: SELLING_PLANS.quarterly
  };

  const cta = document.getElementById('js-cta');
  if (cta) {
    cta.addEventListener('click', (e) => {
      e.preventDefault();
      const dur = document.querySelector('.duration-card.selected');
      const selOpt = document.querySelector('.sub-option.selected');
      const qty = parseInt(dur?.dataset.days || '60', 10);
      const isSub = selOpt?.dataset.type === 'sub';

      const lbl = cta.querySelector('.js-cta-label');
      if (lbl) lbl.textContent = 'Ajout en cours…';
      cta.classList.add('is-loading');

      const payload = { items: [{ id: VARIANTS[qty] || VARIANTS[30], quantity: 1 }] };
      if (isSub) payload.items[0].selling_plan = QTY_TO_PLAN[qty] || SELLING_PLANS.monthly;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(r => r.json())
        .then(data => {
          if (data.status) {
            if (lbl) lbl.textContent = 'Erreur — réessayer';
            cta.classList.remove('is-loading');
          } else {
            if (lbl) lbl.textContent = '✓ Redirection…';
            window.location.href = '/checkout';
          }
        })
        .catch(() => {
          if (lbl) lbl.textContent = 'Erreur — réessayer';
          cta.classList.remove('is-loading');
        });
    });
  }

  // Product tabs
  document.querySelectorAll('.ptab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.ptab').forEach(t => t.classList.remove('selected'));
      tab.classList.add('selected');
    });
  });

  // PDP carousel
  (function() {
    const slides = document.querySelectorAll('.pdp-slide');
    const thumbs = document.querySelectorAll('.pthumb');
    if (!slides.length) return;
    let idx = 0;
    function goto(i) {
      idx = (i + slides.length) % slides.length;
      slides.forEach(s => s.classList.remove('active'));
      slides[idx].classList.add('active');
      thumbs.forEach(t => t.classList.remove('selected'));
      const thumb = document.querySelector('.pthumb[data-go="' + idx + '"]');
      if (thumb) {
        thumb.classList.add('selected');
        thumb.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
      }
    }
    document.querySelectorAll('.pdp-arr').forEach(b => {
      b.addEventListener('click', () => goto(idx + parseInt(b.dataset.dir, 10)));
    });
    thumbs.forEach(t => {
      t.addEventListener('click', () => goto(parseInt(t.dataset.go, 10)));
    });
  })();

  // Box bottom tabs (Comment / Composition / Études)
  document.querySelectorAll('.box-tabs-head .bt').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.bt;
      document.querySelectorAll('.box-tabs-head .bt').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      document.querySelectorAll('.bt-panel').forEach(p => {
        if (p.dataset.panel === key) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    });
  });
</script>

