<script>
(function () {
  'use strict';

  /* ── Scroll reveal ───────────────────────────────────────── */
  var revealEls = document.querySelectorAll('.pp .reveal');
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) e.target.classList.add('in');
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
  revealEls.forEach(function (el) { io.observe(el); });

  /* ── Parallax on product image ───────────────────────────── */
  var imgWrap = document.getElementById('pp-img-wrap');
  if (imgWrap) {
    var raf = 0;
    var onScroll = function () {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        var r = imgWrap.getBoundingClientRect();
        var center = r.top + r.height / 2;
        var offset = (window.innerHeight / 2 - center) * 0.12;
        imgWrap.style.transform = 'translateY(' + offset.toFixed(1) + 'px)';
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  /* ── Confirmation overlay (shared) ──────────────────────── */
  var overlay       = document.getElementById('pp-confirm');
  var overlayEmail  = document.getElementById('pp-confirm-email');
  var overlayClose  = document.getElementById('pp-confirm-close');

  function showConfirm(email) {
    if (!overlay) return;
    overlayEmail.textContent = email;
    overlay.classList.add('on');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function hideConfirm() {
    if (!overlay) return;
    overlay.classList.remove('on');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  if (overlayClose) overlayClose.addEventListener('click', hideConfirm);
  if (overlay) overlay.addEventListener('click', function (e) { if (e.target === overlay) hideConfirm(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay && overlay.classList.contains('on')) hideConfirm(); });

  /* ── Klaviyo single opt-in ───────────────────────────────── */
  var KLAVIYO_URL = 'https://a.klaviyo.com/client/subscriptions/?company_id=QTWcFU';
  var LIST_ID     = 'VaBB62';
  var RE_EMAIL    = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function klaviyoSubscribe(email) {
    return fetch(KLAVIYO_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/vnd.api+json',
        'revision': '2024-10-15'
      },
      body: JSON.stringify({
        data: {
          type: 'subscription',
          attributes: {
            custom_source: 'Landing Opt-In Padel Protocol',
            profile: {
              data: {
                type: 'profile',
                attributes: { email: email }
              }
            }
          },
          relationships: {
            list: { data: { type: 'list', id: LIST_ID } }
          }
        }
      })
    });
  }

  /* ── Wire each opt-in form independently ─────────────────── */
  function initOptForm(form) {
    var field        = form.querySelector('.pp-field');
    var emailInput   = form.querySelector('input[type="email"]');
    var errEl        = form.querySelector('.pp-err-msg');
    var btn          = form.querySelector('button[type="submit"]');
    if (!emailInput || !btn) return;

    var btnOrigHTML = btn.innerHTML;

    function setError(msg) {
      if (field) field.classList.add('err');
      if (errEl) { errEl.textContent = msg; errEl.style.display = 'block'; }
    }

    function clearError() {
      if (field) field.classList.remove('err');
      if (errEl) { errEl.textContent = ''; errEl.style.display = 'none'; }
    }

    function setLoading(on) {
      btn.disabled = on;
      btn.innerHTML = on ? 'Envoi…' : btnOrigHTML;
    }

    emailInput.addEventListener('input', clearError);

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = emailInput.value.trim();

      if (!RE_EMAIL.test(email)) {
        setError('→ Adresse e-mail invalide. Vérifiez et réessayez.');
        return;
      }

      clearError();
      setLoading(true);

      klaviyoSubscribe(email)
        .then(function (res) {
          /* Klaviyo returns 202 on success; also accept 200/204 for robustness */
          if (res.status === 202 || res.status === 200 || res.status === 204) {
            showConfirm(email);
          } else {
            throw new Error('HTTP ' + res.status);
          }
        })
        .catch(function () {
          setError('→ Une erreur est survenue. Réessayez dans quelques secondes.');
        })
        .finally(function () {
          setLoading(false);
        });
    });
  }

  document.querySelectorAll('.pp-opt-form').forEach(initOptForm);
})();
</script>

