        ].map((acc, i) => (
          <div key={acc.key} className="acc" style={i > 0 ? {marginTop:-1} : {}}>
            <button className="acc-head" onClick={() => setOpenAcc(openAcc === acc.key ? null : acc.key)}>
              <span>{acc.title}</span><span>{openAcc === acc.key ? '−' : '+'}</span>
            </button>
            {openAcc === acc.key && <div className="acc-body">{acc.body}</div>}
          </div>
        ))}
      </div>
    </section>
  );
}

