            ))}
          </div>
        </div>

        <div className="qty-line">
          <span className="qty-label">Quantité</span>
          <div className="qty-stepper">
            <button onClick={() => setQty(q => Math.max(1, q-1))} aria-label="−">−</button>
            <input value={qty} readOnly />
            <button onClick={() => setQty(q => q+1)} aria-label="+">+</button>
          </div>
        </div>

        <button className="btn" onClick={handleBuy} disabled={loading}>
          {loading ? 'Ajout en cours…' : `Démarrer mon protocole — ${selected.price * qty}€${selected.suffix}`}
        </button>

        <ul className="reassurance">
          <li>✓ Livraison sous 2 jours ouvrés</li>
          <li>✓ Garantie 60 jours · produit ouvert</li>
          <li>✓ Annulation abonnement en 30 secondes</li>
