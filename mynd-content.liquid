          </div>
          <div className="plan-stack">
            {PLANS.map(p => (
              <button key={p.id} className="plan-row" aria-pressed={plan === p.id} onClick={() => setPlan(p.id)}>
                <span className="radio" />
                <div className="plan-text">
                  <div className="plan-title">
                    {p.label}
                    {p.tag && <span className={`plan-tag${p.id === 'sub' ? ' tag-cta' : ''}`}>{p.tag}</span>}
