<script type="text/babel">
const { useState, useEffect } = React;

const VARIANT_IDS = { once: 53931664572749, pack3: 53931664605517 };

const PLANS = [
  { id:'once',  label:'Achat unique',       sub:'30 sachets · 1 mois',                      price:59,  suffix:'',     perDay:'1,97€/jour', tag:null },
  { id:'sub',   label:'Abonnement mensuel', sub:'−17% · livraison offerte · annulable en 30s', price:49, suffix:'/mois', perDay:'1,63€/jour', tag:'Le plus choisi' },
  { id:'pack3', label:'Pack 3 mois',        sub:'3 paquets · économise 48€',                price:129, suffix:'',     perDay:'1,43€/jour', tag:'Recommandé' },
];

function cartAdd(variantId, qty, setLoading) {
  setLoading(true);
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: qty }),
  }).then(r => r.json()).then(data => {
    if (data.id) { window.location.href = '/cart'; }
    else { alert(data.description || 'Erreur, veuillez réessayer.'); setLoading(false); }
  }).catch(() => { alert('Erreur réseau.'); setLoading(false); });
}

const Stars = ({ n = 5, size = 14 }) => (
  <span className="stars">
    {Array.from({ length: 5 }).map((_, i) => (
      <svg key={i} width={size} height={size} viewBox="0 0 24 24"
        fill={i < n ? 'currentColor' : 'none'} stroke="currentColor" strokeWidth="1.4">
        <path d="M12 2.5l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17.6 5.9 21l1.5-6.8L2.2 9.5l6.9-.7L12 2.5z" />
      </svg>
    ))}
  </span>
);

