    font-weight: 400;
    font-style: italic;
    color: #fff;
    margin-bottom: 36px;
    line-height: 1.3;
  }
  .mynd-final-btn {
    background: var(--purple);
    color: #fff;
    padding: 18px 40px;
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s, transform 0.2s;
    margin-bottom: 80px;
  }
  .mynd-final-btn:hover { background: #6a4fa8; transform: translateY(-2px); }
  .mynd-footer {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 32px;
    position: relative;
    z-index: 1;
  }
  .mynd-footer-copy {
    font-family: var(--font-label);
    font-size: 12px;
    color: rgba(255,255,255,0.3);
    margin-bottom: 10px;
  }
  .mynd-footer-disclaimer {
    font-family: var(--font-label);
    font-size: 11px;
    color: rgba(255,255,255,0.2);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ---- PROTOCOL ID ---- */
  #protocole { scroll-margin-top: 70px; }
  #formule { scroll-margin-top: 70px; }
  #resultats { scroll-margin-top: 70px; }
  #tarifs { scroll-margin-top: 70px; }
  #faq { scroll-margin-top: 70px; }
</style>

<!-- 1. ANNOUNCEMENT BAR -->
<div class="mynd-announcement">
  {{ section.settings.announcement | default: 'Free shipping · Garantie 60 jours · Sans caféine' }}
</div>

<!-- 2. NAV -->
<nav class="mynd-nav" id="mynd-nav">
  <div class="mynd-nav-inner">
    <a href="#top" class="mynd-nav-logo">MYND</a>
    <ul class="mynd-nav-links">
      <li><a href="#formule">Formule</a></li>
      <li><a href="#resultats">Résultats</a></li>
      <li><a href="#tarifs">Tarifs</a></li>
      <li><a href="#faq">FAQ</a></li>
      <li><a href="#tarifs" class="mynd-nav-cta">Commander →</a></li>
    </ul>
  </div>
</nav>
<div class="mynd-nav-spacer"></div>

<!-- 3. HERO -->
<section class="mynd-hero" id="top">
  <div class="mynd-hero-inner">
    <div class="mynd-hero-left">
      <div class="mynd-hero-badge">Dual-Fuel</div>
      <h1><em>4–6h de concentration profonde.</em><br>Chaque jour.</h1>
      <p class="mynd-hero-body">La première formule nootropique à double action : soutien cognitif et énergie cellulaire réunis dans une gélule. Conçue pour les esprits exigeants qui refusent de choisir entre performance et équilibre.</p>
      <div class="mynd-hero-ctas">
        <a href="#tarifs" class="btn-primary">Commander MYND</a>
        <a href="#resultats" class="btn-outline">Découvrir MYND</a>
      </div>
      <div class="mynd-hero-trust">
        <div class="mynd-trust-item">
          <span class="mynd-trust-value">+200</span>
          <span class="mynd-trust-label">beta-testeurs</span>
        </div>
        <div class="mynd-trust-item">
          <span class="mynd-trust-value">4.9★</span>
          <span class="mynd-trust-label">600 avis</span>
        </div>
        <div class="mynd-trust-item">
          <span class="mynd-trust-value">J7</span>
          <span class="mynd-trust-label">premiers effets</span>
        </div>
        <div class="mynd-trust-item">
          <span class="mynd-trust-value">60j</span>
          <span class="mynd-trust-label">garantie</span>
        </div>
      </div>
    </div>
    <div class="mynd-hero-visual">
      <div class="mynd-float-circle c1"></div>
      <div class="mynd-float-circle c2"></div>
      <div class="mynd-float-circle c3"></div>
      {% if section.settings.hero_image %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 800 }}"
          alt="MYND — Formule Dual-Fuel"
          class="mynd-hero-img"
          loading="eager"
        >
      {% else %}
        <div class="mynd-hero-placeholder">MYND</div>
      {% endif %}
    </div>
  </div>
</section>

<!-- 4. MARQUEE -->
<div class="mynd-marquee-section">
  <div class="mynd-marquee-track">
    {% assign marquee_items = "Lion's Mane,Shilajit,Vitamines B,Vegan,Sans caféine,Sans sucre,Fabriqué en Allemagne,GMP,Testé en labo" | split: "," %}
    {% for g in (1..3) %}
    <div class="mynd-marquee-group">
      {% for item in marquee_items %}
      <div class="mynd-marquee-item"><span>✦</span>{{ item }}</div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>

<!-- 5. LIFESTYLE STRIP -->
<section class="mynd-lifestyle">
  <div class="mynd-lifestyle-grid">
    {% for i in (1..4) %}
      {% assign img_key = 'lifestyle_' | append: i %}
      {% assign img_val = section.settings[img_key] %}
      <div class="mynd-lifestyle-cell">
        {% if img_val %}
          <img src="{{ img_val | image_url: width: 600 }}" alt="MYND lifestyle {{ i }}" loading="lazy">
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<!-- 6. TESTIMONIALS -->
<section class="mynd-testimonials">
  <div class="mynd-testimonials-header">
    <h2>Ils ont testé. <em>Ils ne reviennent plus en arrière.</em></h2>
  </div>
  <div class="mynd-carousel-wrap">
    <div class="mynd-carousel-slides">
      <div class="mynd-carousel-track" id="mynd-carousel-track">
        <!-- Slide 1 -->
        <div class="mynd-slide">
          <div>
            <div class="mynd-slide-quote">"Après 3 semaines, mes matinées ont changé du tout au tout. Je suis concentré avant même mon premier café."</div>
            <p class="mynd-slide-body">Je travaille en freelance et la procrastination était mon ennemi numéro un. MYND a vraiment fait la différence sur ma capacité à démarrer et à rester dans le flux.</p>
          </div>
          <div class="mynd-slide-avatar">
            <div class="mynd-avatar-circle">T</div>
            <div>
              <div class="mynd-avatar-name">Thomas M.</div>
              <div class="mynd-avatar-role">Développeur freelance, Paris</div>
            </div>
          </div>
        </div>
        <!-- Slide 2 -->
        <div class="mynd-slide">
          <div>
            <div class="mynd-slide-quote">"Pas de crash l'après-midi. C'est la première fois que je traverse mes journées sans ce coup de fatigue de 15h."</div>
            <p class="mynd-slide-body">J'ai essayé beaucoup de compléments. MYND est le premier qui tient ses promesses sans effets secondaires désagréables. L'énergie est douce et soutenue.</p>
          </div>
          <div class="mynd-slide-avatar">
            <div class="mynd-avatar-circle">P</div>
            <div>
              <div class="mynd-avatar-name">Philippe R.</div>
              <div class="mynd-avatar-role">Directeur Marketing, Lyon</div>
            </div>
          </div>
        </div>
        <!-- Slide 3 -->
        <div class="mynd-slide">
          <div>
            <div class="mynd-slide-quote">"Je pensais que c'était impossible de rester focus après 18h avec deux enfants à la maison. MYND a changé ça."</div>
            <p class="mynd-slide-body">La qualité de ma présence le soir a vraiment évolué. Je suis là, je profite, sans cette fatigue mentale qui me coupait de tout dès la sortie du bureau.</p>
          </div>
          <div class="mynd-slide-avatar">
            <div class="mynd-avatar-circle">D</div>
            <div>
              <div class="mynd-avatar-name">Diana L.</div>
              <div class="mynd-avatar-role">Avocate, Bordeaux</div>
            </div>
          </div>
        </div>
        <!-- Slide 4 -->
        <div class="mynd-slide">
          <div>
            <div class="mynd-slide-quote">"Au bout de 30 jours, mon équipe m'a demandé ce que j'avais changé. Juste MYND."</div>
            <p class="mynd-slide-body">Mon niveau de base a monté. Ce n'est pas un boost temporaire — c'est une amélioration durable de ma clarté mentale et de ma capacité d'exécution.</p>
          </div>
          <div class="mynd-slide-avatar">
            <div class="mynd-avatar-circle">R</div>
            <div>
              <div class="mynd-avatar-name">Romain D.</div>
              <div class="mynd-avatar-role">Entrepreneur, Nantes</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mynd-carousel-nav">
      <button class="mynd-arrow" id="mynd-prev" aria-label="Précédent">‹</button>
      <button class="mynd-dot active" data-slide="0" aria-label="Slide 1"></button>
      <button class="mynd-dot" data-slide="1" aria-label="Slide 2"></button>
      <button class="mynd-dot" data-slide="2" aria-label="Slide 3"></button>
      <button class="mynd-dot" data-slide="3" aria-label="Slide 4"></button>
      <button class="mynd-arrow" id="mynd-next" aria-label="Suivant">›</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MYND Landing — Top",
