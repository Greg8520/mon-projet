    { "type": "image_picker", "id": "hero_image", "label": "Hero product image" },
    { "type": "image_picker", "id": "lifestyle_1", "label": "Lifestyle photo 1" },
    { "type": "image_picker", "id": "lifestyle_2", "label": "Lifestyle photo 2" },
