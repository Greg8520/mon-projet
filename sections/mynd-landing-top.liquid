<!-- MYND Landing Page — Shopify Liquid Section -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Archivo:wght@300;400;500;600;700&family=Archivo+Narrow:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --iridescent: linear-gradient(135deg, #F0D8F0 0%, #D8E8F8 28%, #D8F0E8 50%, #F8E8D0 72%, #E8D8F8 100%);
    --reflet: linear-gradient(90deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.28) 22%, rgba(255,255,255,0) 45%);
    --bg-primary: #f5f2ff;
    --dark: #1a1a2e;
    --purple: #7c5cba;
    --font-heading: 'Instrument Serif', serif;
    --font-body: 'Archivo', sans-serif;
    --font-label: 'Archivo Narrow', sans-serif;
  }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font-body); background: #fff; color: var(--dark); overflow-x: hidden; }

  /* ---- ANIMATIONS ---- */
  @keyframes floatC {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-10px, -20px); }
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.05); }
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---- ANNOUNCEMENT BAR ---- */
  .mynd-announcement {
    background: var(--dark);
    color: #fff;
    text-align: center;
    padding: 10px 20px;
    font-family: var(--font-label);
    font-size: 13px;
    letter-spacing: 0.04em;
    position: relative;
    z-index: 200;
  }

  /* ---- NAV ---- */
  .mynd-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(245, 242, 255, 0.92);
    backdrop-filter: blur(0px);
    transition: backdrop-filter 0.3s, background 0.3s, box-shadow 0.3s;
    border-bottom: 1px solid rgba(124, 92, 186, 0.1);
  }
  .mynd-nav.scrolled {
    backdrop-filter: blur(16px);
    background: rgba(245, 242, 255, 0.85);
    box-shadow: 0 2px 24px rgba(124,92,186,0.08);
  }
  .mynd-nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 32px;
  }
  .mynd-nav-logo {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--dark);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .mynd-nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .mynd-nav-links a {
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 500;
    color: var(--dark);
    text-decoration: none;
    letter-spacing: 0.02em;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .mynd-nav-links a:hover { opacity: 1; }
  .mynd-nav-cta {
    background: var(--purple);
    color: #fff !important;
    opacity: 1 !important;
    padding: 9px 20px;
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .mynd-nav-cta:hover { background: #6a4fa8; transform: translateY(-1px); }
  @media (max-width: 768px) {
    .mynd-nav-links { display: none; }
    .mynd-nav-inner { padding: 14px 20px; }
  }

  /* ---- NAV SPACER ---- */
  .mynd-nav-spacer { height: 60px; }

  /* ---- HERO ---- */
  .mynd-hero {
    background: var(--iridescent);
    padding: 80px 32px 80px;
    position: relative;
    overflow: hidden;
  }
  .mynd-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 60px;
    align-items: center;
  }
  .mynd-hero-badge {
    display: inline-block;
    background: rgba(124, 92, 186, 0.12);
    border: 1px solid rgba(124, 92, 186, 0.3);
    color: var(--purple);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 24px;
  }
  .mynd-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(38px, 5vw, 62px);
    font-weight: 400;
    line-height: 1.12;
    color: var(--dark);
    margin-bottom: 22px;
  }
  .mynd-hero h1 em { font-style: italic; }
  .mynd-hero-body {
    font-size: 17px;
    line-height: 1.7;
    color: rgba(26,26,46,0.75);
    margin-bottom: 36px;
    max-width: 480px;
  }
  .mynd-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .btn-primary {
    background: var(--purple);
    color: #fff;
    padding: 14px 28px;
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    display: inline-block;
  }
  .btn-primary:hover { background: #6a4fa8; transform: translateY(-1px); }
  .btn-outline {
    background: transparent;
    color: var(--dark);
    border: 1.5px solid rgba(26,26,46,0.3);
    padding: 14px 28px;
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
    display: inline-block;
  }
  .btn-outline:hover { border-color: var(--purple); transform: translateY(-1px); }
  .mynd-hero-trust {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .mynd-trust-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mynd-trust-value {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--dark);
  }
  .mynd-trust-label {
    font-family: var(--font-label);
    font-size: 11px;
    color: rgba(26,26,46,0.55);
    letter-spacing: 0.04em;
  }
  .mynd-hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 420px;
  }
  .mynd-hero-img {
    width: 100%;
    max-width: 380px;
    height: auto;
    border-radius: 24px;
    position: relative;
    z-index: 2;
    object-fit: cover;
  }
  .mynd-hero-placeholder {
    width: 320px;
    height: 420px;
    background: var(--iridescent);
    border-radius: 24px;
    border: 2px solid rgba(255,255,255,0.6);
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 32px;
    color: var(--purple);
    opacity: 0.7;
  }
  .mynd-float-circle {
    position: absolute;
    border-radius: 50%;
    background: var(--iridescent);
    opacity: 0.55;
    animation: floatC 7s ease-in-out infinite;
  }
  .mynd-float-circle.c1 { width: 180px; height: 180px; top: -30px; right: -30px; animation-delay: 0s; }
  .mynd-float-circle.c2 { width: 120px; height: 120px; bottom: 40px; left: -20px; animation-delay: 2.5s; }
  .mynd-float-circle.c3 { width: 80px; height: 80px; top: 50%; right: 20px; animation-delay: 4.5s; }
  @media (max-width: 900px) {
    .mynd-hero-inner { grid-template-columns: 1fr; }
    .mynd-hero-visual { min-height: 280px; }
  }

  /* ---- MARQUEE ---- */
  .mynd-marquee-section {
    background: var(--dark);
    padding: 18px 0;
    overflow: hidden;
  }
  .mynd-marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }
  .mynd-marquee-group {
    display: flex;
    gap: 0;
  }
  .mynd-marquee-item {
    color: #fff;
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0 32px;
    white-space: nowrap;
    opacity: 0.85;
  }
  .mynd-marquee-item span { color: rgba(240,216,240,0.7); margin-right: 6px; }

  /* ---- LIFESTYLE STRIP ---- */
  .mynd-lifestyle {
    padding: 48px 32px;
    background: #fff;
  }
  .mynd-lifestyle-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .mynd-lifestyle-cell {
    aspect-ratio: 1 / 1.1;
    border-radius: 20px;
    overflow: hidden;
    background: var(--iridescent);
  }
  .mynd-lifestyle-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .mynd-lifestyle-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---- TESTIMONIALS ---- */
  .mynd-testimonials {
    background: var(--bg-primary);
    padding: 80px 32px;
  }
  .mynd-testimonials-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .mynd-testimonials-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4vw, 48px);
    color: var(--dark);
    font-weight: 400;
  }
  .mynd-testimonials-header h2 em { font-style: italic; }
  .mynd-carousel-wrap {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
  }
  .mynd-carousel-slides {
    overflow: hidden;
    border-radius: 24px;
  }
  .mynd-carousel-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);
  }
  .mynd-slide {
    min-width: 100%;
    background: var(--dark);
    border-radius: 24px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
    color: #fff;
  }
  .mynd-slide-quote {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 400;
    line-height: 1.35;
    font-style: italic;
    margin-bottom: 16px;
  }
  .mynd-slide-body {
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255,255,255,0.7);
  }
  .mynd-slide-avatar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .mynd-avatar-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--iridescent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 28px;
    color: var(--dark);
    font-weight: 600;
  }
  .mynd-avatar-name {
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    color: #fff;
  }
  .mynd-avatar-role {
    font-family: var(--font-label);
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    margin-top: 2px;
  }
  .mynd-carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }
  .mynd-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(124,92,186,0.3);
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .mynd-dot.active { background: var(--purple); transform: scale(1.3); }
  .mynd-arrow {
    background: rgba(124,92,186,0.1);
    border: 1px solid rgba(124,92,186,0.2);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: var(--purple);
    transition: background 0.2s;
  }
  .mynd-arrow:hover { background: rgba(124,92,186,0.2); }
  @media (max-width: 700px) {
    .mynd-slide { grid-template-columns: 1fr; padding: 32px 24px; }
    .mynd-slide-avatar { flex-direction: row; text-align: left; }
  }

  /* ---- EXPECTATIONS ---- */
  .mynd-expectations {
    background: #fff;
    padding: 80px 32px;
  }
  .mynd-expectations-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .mynd-expectations-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4vw, 50px);
    font-weight: 400;
    color: var(--dark);
  }
  .mynd-expectations-header h2 em { font-style: italic; }
  .mynd-scene {
    max-width: 1100px;
    margin: 0 auto 64px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .mynd-scene.flip .mynd-scene-text { order: 2; }
  .mynd-scene.flip .mynd-scene-visual { order: 1; }
  .mynd-scene-metric {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 16px;
    color: var(--dark);
  }
  .mynd-scene h3 {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--dark);
    margin-bottom: 16px;
  }
  .mynd-scene h3 em { font-style: italic; }
  .mynd-scene p {
    font-size: 16px;
    line-height: 1.75;
    color: rgba(26,26,46,0.7);
  }
  .mynd-scene-card {
    background: var(--iridescent);
    border-radius: 24px;
    padding: 40px;
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .mynd-scene-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--reflet);
    border-radius: 24px;
    pointer-events: none;
  }
  /* SVG / data viz inside cards */
  .mynd-viz { width: 100%; position: relative; z-index: 1; }
  .mynd-todo-list { list-style: none; width: 100%; }
  .mynd-todo-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--dark);
    padding: 8px 0;
    border-bottom: 1px solid rgba(26,26,46,0.08);
  }
  .mynd-todo-check {
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--purple);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 11px;
    flex-shrink: 0;
  }
  .mynd-bar-chart { width: 100%; }
  .mynd-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-family: var(--font-label);
    font-size: 13px;
    color: var(--dark);
  }
  .mynd-bar-label { width: 60px; }
  .mynd-bar-bg {
    flex: 1;
    height: 10px;
    background: rgba(26,26,46,0.1);
    border-radius: 5px;
    overflow: hidden;
  }
  .mynd-bar-fill {
    height: 100%;
    background: var(--purple);
    border-radius: 5px;
    transition: width 0.8s;
  }
  @media (max-width: 768px) {
    .mynd-scene { grid-template-columns: 1fr; gap: 32px; }
    .mynd-scene.flip .mynd-scene-text { order: 0; }
    .mynd-scene.flip .mynd-scene-visual { order: 1; }
  }

  /* ---- PROTOCOL ---- */
  .mynd-protocol {
    background: var(--dark);
    padding: 80px 32px;
    position: relative;
    overflow: hidden;
  }
  .mynd-protocol-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.18;
    pointer-events: none;
  }
  .mynd-protocol-blob.b1 { width: 400px; height: 400px; background: #F0D8F0; top: -100px; left: -100px; }
  .mynd-protocol-blob.b2 { width: 350px; height: 350px; background: #D8E8F8; bottom: -80px; right: -80px; }
  .mynd-protocol-header {
    text-align: center;
    margin-bottom: 56px;
    position: relative;
    z-index: 1;
  }
  .mynd-protocol-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 400;
    color: #fff;
    line-height: 1.2;
  }
  .mynd-protocol-header h2 em { font-style: italic; color: rgba(240,216,240,0.85); }
  .mynd-dual-cards {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    max-width: 860px;
    margin: 0 auto 48px;
    position: relative;
    z-index: 1;
  }
  .mynd-dual-card {
    flex: 1;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 36px 32px;
    color: #fff;
  }
  .mynd-dual-card-tag {
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240,216,240,0.65);
    margin-bottom: 12px;
  }
  .mynd-dual-card h3 {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 400;
    margin-bottom: 12px;
    font-style: italic;
  }
  .mynd-dual-card-ingredients {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .mynd-ingredient-pill {
    background: rgba(240,216,240,0.15);
    border: 1px solid rgba(240,216,240,0.2);
    color: rgba(255,255,255,0.85);
    font-family: var(--font-label);
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 100px;
  }
  .mynd-dual-card p {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255,255,255,0.6);
  }
  .mynd-plus-divider {
    font-family: var(--font-heading);
    font-size: 36px;
    color: rgba(240,216,240,0.5);
    padding: 0 24px;
    flex-shrink: 0;
  }
  .mynd-result-banner {
    background: var(--iridescent);
    border-radius: 20px;
    padding: 28px 40px;
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .mynd-result-banner p {
    font-family: var(--font-heading);
    font-size: clamp(16px, 2.5vw, 22px);
    color: var(--dark);
    font-style: italic;
    line-height: 1.4;
  }
  @media (max-width: 700px) {
    .mynd-dual-cards { flex-direction: column; gap: 16px; }
    .mynd-plus-divider { padding: 8px 0; }
  }

  /* ---- FORMULA ---- */
  .mynd-formula {
    background: var(--bg-primary);
    padding: 80px 32px;
  }
  .mynd-formula-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .mynd-formula-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .mynd-formula-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 400;
    color: var(--dark);
    line-height: 1.15;
  }
  .mynd-formula-header h2 em { font-style: italic; }
  .mynd-ingredients-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 40px;
  }
  .mynd-ing-card {
    background: var(--iridescent);
    border-radius: 18px;
    padding: 24px;
    position: relative;
    overflow: hidden;
  }
  .mynd-ing-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--reflet);
    pointer-events: none;
  }
  .mynd-ing-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    color: var(--dark);
    margin-bottom: 6px;
    position: relative;
    z-index: 1;
  }
  .mynd-ing-role {
    font-family: var(--font-label);
    font-size: 12px;
    color: rgba(26,26,46,0.6);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }
  .mynd-checklist {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
    margin-bottom: 40px;
    list-style: none;
  }
