<script>
(function() {
  // ---- NAV SCROLL BLUR ----
  var nav = document.getElementById('mynd-nav');
  if (nav) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 20) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    }, { passive: true });
  }

  // ---- TESTIMONIAL CAROUSEL ----
  var track = document.getElementById('mynd-carousel-track');
  var dots = document.querySelectorAll('.mynd-dot');
  var prevBtn = document.getElementById('mynd-prev');
  var nextBtn = document.getElementById('mynd-next');
  var currentSlide = 0;
  var totalSlides = 4;
  var autoAdvanceTimer = null;

  function goToSlide(n) {
    currentSlide = ((n % totalSlides) + totalSlides) % totalSlides;
    if (track) track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
    dots.forEach(function(d, i) {
      d.classList.toggle('active', i === currentSlide);
    });
  }

  function startAutoAdvance() {
    clearInterval(autoAdvanceTimer);
    autoAdvanceTimer = setInterval(function() {
      goToSlide(currentSlide + 1);
    }, 5500);
  }

  if (track) {
    dots.forEach(function(d) {
      d.addEventListener('click', function() {
        goToSlide(parseInt(this.dataset.slide));
        startAutoAdvance();
      });
    });
    if (prevBtn) prevBtn.addEventListener('click', function() { goToSlide(currentSlide - 1); startAutoAdvance(); });
    if (nextBtn) nextBtn.addEventListener('click', function() { goToSlide(currentSlide + 1); startAutoAdvance(); });
    startAutoAdvance();
  }

  // ---- TIMELINE ----
  var phases = [
    { day: 'J1', title: 'Démarrage du protocole', body: 'Ton corps commence à assimiler les actifs. La biodisponibilité du Shilajit assure un démarrage rapide du soutien énergétique mitochondrial dès les premières prises.', progress: 5 },
    { day: 'J7', title: 'Premiers signaux de clarté', body: 'Les premiers effets commencent à se manifester : meilleure clarté au réveil, réduction de la brume mentale, plus grande facilité à démarrer les tâches.', progress: 25 },
    { day: 'J30', title: 'Initiation de la plasticité neuronale', body: 'Le Lion's Mane stimule activement la production de NGF. La mémoire de travail s'améliore, les états de flow sont plus fréquents et plus durables.', progress: 50 },
    { day: 'J60', title: 'Progression structurelle', body: 'Les bénéfices cognitifs s'ancrent en profondeur. L'énergie est stable tout au long de la journée. Les après-midis ne sont plus synonymes de fatigue.', progress: 80 },
    { day: 'J90', title: 'Optimisation complète', body: 'L'état cognitif optimal est atteint. Ton nouveau niveau de base correspond à ce que tu avais connu lors de tes meilleures journées. MYND devient ton standard.', progress: 100 }
  ];

  var tlDay = document.getElementById('tl-day');
  var tlTitle = document.getElementById('tl-title');
  var tlBody = document.getElementById('tl-body');
  var tlProgress = document.getElementById('tl-progress');
  var phaseBtns = document.querySelectorAll('.mynd-phase-btn');

  phaseBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var idx = parseInt(this.dataset.phase);
      phaseBtns.forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      var p = phases[idx];
      if (tlDay) tlDay.textContent = p.day;
      if (tlTitle) tlTitle.textContent = p.title;
      if (tlBody) tlBody.textContent = p.body;
      if (tlProgress) tlProgress.style.width = p.progress + '%';
      var display = document.getElementById('mynd-timeline-display');
      if (display) {
        display.style.animation = 'none';
        display.offsetHeight; // reflow
        display.style.animation = 'fadeIn 0.4s ease';
      }
    });
  });

  // ---- ACCORDION (Formula) ----
  document.querySelectorAll('.mynd-accordion-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = this.dataset.acc;
      var acc = document.getElementById(id);
      if (acc) {
        acc.classList.toggle('open');
      }
    });
  });

  // ---- FAQ ACCORDION ----
  document.querySelectorAll('.mynd-faq-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = this.dataset.faq;
      var item = document.getElementById(id);
      var grid = document.getElementById('mynd-faq-grid');
      if (item) {
        var wasOpen = item.classList.contains('open');
        // Close all
        document.querySelectorAll('.mynd-faq-item').forEach(function(fi) {
          fi.classList.remove('open');
        });
        // Reflow grid to handle column span changes
        if (!wasOpen) {
          item.classList.add('open');
        }
      }
    });
  });

  // ---- PRICING ----
  var isSubscription = false;
  var selectedQty = 60;

  var qtyOpts = document.querySelectorAll('.mynd-qty-opt');
  var qtyTabs = document.querySelectorAll('.mynd-qty-tab');
  var subToggle = document.getElementById('mynd-sub-toggle');
  var toggleSw = document.getElementById('mynd-toggle-sw');
  var totalPriceEl = document.getElementById('mynd-total-price');

  function getPriceForOpt(opt, sub) {
    var once = parseInt(opt.dataset.priceOnce);
    var s = parseInt(opt.dataset.priceSub);
    return sub ? s : once;
  }

  function updatePrices() {
    qtyOpts.forEach(function(opt) {
      var priceDiv = opt.querySelector('.mynd-qty-price > div:first-child');
      var origDiv = opt.querySelector('.mynd-qty-price-orig');
      var once = parseInt(opt.dataset.priceOnce);
      var sub = parseInt(opt.dataset.priceSub);
      if (isSubscription) {
        if (priceDiv) priceDiv.textContent = sub + '€';
        if (origDiv) origDiv.textContent = once + '€';
      } else {
        if (priceDiv) priceDiv.textContent = once + '€';
        if (origDiv) origDiv.textContent = '';
      }
    });
    var selected = document.querySelector('.mynd-qty-opt.selected');
    if (selected && totalPriceEl) {
      var price = isSubscription ? parseInt(selected.dataset.priceSub) : parseInt(selected.dataset.priceOnce);
      totalPriceEl.textContent = price + '€';
    }
  }

  qtyOpts.forEach(function(opt) {
    opt.addEventListener('click', function() {
      qtyOpts.forEach(function(o) { o.classList.remove('selected'); });
      this.classList.add('selected');
      updatePrices();
    });
  });

  qtyTabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      qtyTabs.forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      isSubscription = (this.dataset.mode === 'subscription');
      if (toggleSw) toggleSw.classList.toggle('on', isSubscription);
      updatePrices();
    });
  });

  if (subToggle) {
    subToggle.addEventListener('click', function() {
      isSubscription = !isSubscription;
      if (toggleSw) toggleSw.classList.toggle('on', isSubscription);
      qtyTabs.forEach(function(t) {
        t.classList.toggle('active', t.dataset.mode === (isSubscription ? 'subscription' : 'one-time'));
      });
      updatePrices();
    });
  }
})();
</script>

